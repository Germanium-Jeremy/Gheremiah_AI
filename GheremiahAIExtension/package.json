{
  "name": "gheremiah-ai-extension",
  "displayName": "Gheremiah AI Assistant",
  "description": "An AI-powered chat bot for Python, JS, and TS powered by Gemini 2.5 Flash",
  "version": "0.0.1",
  "publisher": "Jeremie",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "Machine Learning",
    "VS code",
    "Extension",
    "Learn Making VS code extension",
    "AI APIs"
  ],
  "activationEvents": [
    "onCommand:gheremiahai.start"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gheremiahai.start",
        "title": "Gheremiah AI: Start"
      }
    ],
    "configuration": {
    "title": "Gheremiah AI Assistant",
    "properties": {
      "gemini.apiKey": {
        "type": "string",
        "default": "",
        "description": "Gemini API key from Google AI Studio"
      },
      "url.backend": {
        "type": "string",
        "default": "https://gheremiah-ai-backend.onrender.com",
        "description": "Backend Url"
      },
      "url.frontend": {
        "type": "string",
        "default": "https://gheremiahai.vercel.app",
        "description": "Frontend Url"
      }
    }
  }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:css",
    "compile": "tsc -p ./",
    "watch": "npm run watch:ts & npm run watch:css",
    "watch:ts": "tsc -watch -p ./",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "start": "http-server"
  },
  "keywords": [
    "AI",
    "Chat Bot",
    "Gemini",
    "VSCode Extension"
  ],
  "author": "NKUNDABAGENZI Jeremie",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Germanium-Jeremy/Gheremiah_AI.git"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@types/dompurify": "^3.0.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.x"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "marked": "^11.1.1",
    "highlight.js": "^11.9.0",
    "dompurify": "^3.0.6",
    "dotenv": "^16.3.1"
  }
}
