# Server
PORT=8000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/gheremiah-ai

# Authentication
JWT_SECRET=your secret key here
JWT_EXPIRE=1d
REFRESH_TOKEN_EXPIRE=7d

# Google Gemini API
GOOGLE_API_KEY=your-google-gemini-api-key

# Frontend URL (for CORS)
FRONTEND_URL=url to your frontend application
BACKEND_URL = url to your backend application

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=False
SMTP_USER=username for your email account
SMTP_PASS=password for your email account
SMTP_FROM=the email address you want to send emails from
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False